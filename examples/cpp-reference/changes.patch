 #include "retry_policy.h"
 
+#include <algorithm>
+#include <chrono>
+
 namespace trace_demo {
 
-RetryPolicy::RetryPolicy(int delay_ms) : delay_ms_(delay_ms) {}
+namespace {
+constexpr auto kMaximumDelay = std::chrono::seconds(30);
+}
 
-int RetryPolicy::delay_ms_for_attempt(int attempt) const {
-  if (attempt <= 1) {
-    return delay_ms_;
-  }
+RetryPolicy::RetryPolicy(std::chrono::milliseconds base_delay)
+    : base_delay_(base_delay) {}
 
-  return delay_ms_ * attempt;
+std::chrono::milliseconds RetryPolicy::delay_for_attempt(int attempt) const {
+  const int exponent = std::max(0, attempt - 1);
+  const auto multiplier = 1 << std::min(exponent, 10);
+  return std::min(base_delay_ * multiplier, kMaximumDelay);
 }
 
 }  // namespace trace_demo
diff --git a/tests/retry_policy_backoff_test.cpp b/tests/retry_policy_backoff_test.cpp
new file mode 100644
index 0000000..af212da
--- /dev/null
+++ b/tests/retry_policy_backoff_test.cpp
@@ -0,0 +1,22 @@
+#include "retry_policy.h"
+
+#include <cassert>
+#include <chrono>
+
+using namespace std::chrono_literals;
+
+int main() {
+  const trace_demo::RetryPolicy policy(250ms);
+
+  assert(policy.delay_for_attempt(0) == 250ms);
+  assert(policy.delay_for_attempt(1) == 250ms);
+  assert(policy.delay_for_attempt(2) == 500ms);
+  assert(policy.delay_for_attempt(3) == 1000ms);
+
+  const trace_demo::RetryPolicy capped_policy(10s);
+  assert(capped_policy.delay_for_attempt(4) == 30s);
+  assert(capped_policy.delay_for_attempt(20) == 30s);
+
+  return 0;
+}
